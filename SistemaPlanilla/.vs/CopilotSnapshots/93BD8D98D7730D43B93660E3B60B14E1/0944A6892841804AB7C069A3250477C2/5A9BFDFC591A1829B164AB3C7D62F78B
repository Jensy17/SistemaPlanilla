using SistemaPlanilla.BLL;
using SistemaPlanilla.DAL;
using SistemaPlanilla.DAL.Common;
using SistemaPlanilla.UI.Formularios;
using SistemaPlanilla.UI.Formularios.Seguridad;

namespace SistemaPlanilla.UI
{
    internal static class Program
    {
        /// <summary>
        ///  The main entry point for the application.
        /// </summary>
        [STAThread]
        static void Main()
        {
            
            ApplicationConfiguration.Initialize();

            ConfiguracionDAL configuracionDAL = new ConfiguracionDAL();
            
            // Si no existe la configuración solicitarla
            if(!configuracionDAL.ExisteConfiguracion())
            {
                FrmConfiguracionConexion frmConfig = new FrmConfiguracionConexion();
                DialogResult result = frmConfig.ShowDialog();

                if (result != DialogResult.Cancel)
                {
                    return; // Salir de la aplicación si el usuario cancela la configuración
                }
            }

            // Leer la comfiguración guardada
            var config = configuracionDAL.Obtener();

            if(config is null)
            {
                MessageBox.Show("No se pudo obtener la configuración de la base de datos. La aplicación se cerrará.", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
                return; // Salir de la aplicación si no se puede obtener la configuración
            }

            //Construir la cadena de conexión
            Conexion.CadenaConexion = 
                $"Server={config.Servidor};" +
                $"Database={config.BaseDatos};" +
                $"User Id={config.UsuarioSql};" +
                $"Password={config.Password};" +
                $"TrustServerCertificate=True;";

            try
            {
                SistemaBLL sistemaBll = new SistemaBLL(new SistemaDAL());

                sistemaBll.CrearAdministradorInicialAsync()
                    .GetAwaiter()
                    .GetResult();

            }
            catch(Exception ex)
            {
                MessageBox.Show(ex.Message, "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
                return; // Salir de la aplicación si ocurre un error
            }

            Application.Run(new Form1());
        }
    }
}