using SistemaPlanilla.UI.Formularios.Empresa;
using SistemaPlanilla.UI.Helpers;
using System;
using System.Collections.Generic;
using System.ComponentModel;
using System.Configuration;
using System.Data;
using System.Drawing;
using System.Text;
using System.Windows.Forms;
using System.Xml.Serialization;

namespace SistemaPlanilla.UI.Formularios.Colaboradores
{
    public partial class FrmColaboradores : Form
    {
        protected int PaginaActual = 1;
        protected int TamPagina = 10;
        protected int TotalRegistros = 0;
        protected int TotalPaginas = 0;
        public FrmColaboradores()
        {
            InitializeComponent();
        }

        #region Métodos virtuales

        protected virtual bool MostrarBotonPrincipal => true;
        protected virtual bool MostrarBotonSecundario => true;
        protected virtual bool MostrarBotonTerciario => true;
        protected virtual Task MostrarDatosAsync(int Pagina, int tamPagina, string? buscar = null)
        {
            return Task.CompletedTask;
        }


        protected void ActualizarBotonesPaginacion()
        {
            // Sin registros
            if (TotalRegistros == 0)
            {
                btnAnterior.Enabled = false;
                btnSiguiente.Enabled = false;
                return;
            }

            // Primer página
            btnAnterior.Enabled = PaginaActual > 1;
            btnSiguiente.Enabled = PaginaActual > 1;

            // Ultima página
            btnSiguiente.Enabled = PaginaActual < TotalPaginas;
        }

        protected void ActualizarPaginacion()
        {
            if (TotalRegistros == 0)
            {
                lblPagina.Text = "Página 0 de 0";
                lblTotalRegistros.Text = "Total de registros: 0";

                ActualizarBotonesPaginacion();
                return;
            }

            lblPagina.Text = $"Página {PaginaActual} de {TotalPaginas}";
            lblTotalRegistros.Text = $"Total de registros: {TotalRegistros}";

            ActualizarBotonesPaginacion();
        }


        protected virtual Form? CrearFormularioAccionPrincipal()
        {
            return null;
        }
        protected virtual Form? CrearFormularioAccionSecundaria(int id)
        {
            return null;
        }
        protected virtual int? ObtenerIdSeleccionado()
        {
            return null;
        }

        protected virtual Task DesactivarAsync()
        {
            return Task.CompletedTask;
        }

        protected virtual void FormatearCelda(DataGridViewCellFormattingEventArgs e)
        {
            if (dgvListadoColaboradores.Columns[e.ColumnIndex].Name != "Estado")
                return;

            GridColorHelper.FormatearActivoInactivo(e);
        }

        protected void AjustarColumnas(params string[] columnas)
        {
            foreach (string columna in columnas)
            {
                if (!dgvListadoColaboradores.Columns.Contains(columna))
                    continue;

                dgvListadoColaboradores.Columns[columna]!.AutoSizeMode = DataGridViewAutoSizeColumnMode.AllCells;
            }
        }

        #endregion

        #region Personalizar Formulario

        private async void FrmColaboradores_Load(object sender, EventArgs e)
        {

            btnAdd.Visible = MostrarBotonPrincipal;
            btnEditar.Visible = MostrarBotonSecundario;
            btnBaja.Visible = MostrarBotonTerciario;

            GridDashboardHelper.Personalizar(dgvListadoColaboradores);

            await MostrarDatosAsync(PaginaActual, TamPagina, txtBuscar.Text);
        }

        #endregion

        private async void txtBuscar_TextChanged(object sender, EventArgs e)
        {
            PaginaActual = 1;

            await MostrarDatosAsync(PaginaActual, TamPagina, txtBuscar.Text);
        }

        private void dgvListadoColaboradores_CellFormatting(object sender, DataGridViewCellFormattingEventArgs e)
        {
            FormatearCelda(e);
        }

        private void FrmColaboradores_Shown(object sender, EventArgs e)
        {
            RedondearControles.RedondearControl(panelContenido, 20);
            RedondearControles.RedondearControl(panelPaginacion, 20);

            RedondearControles.RedondearControl(btnAdd, 12);
            RedondearControles.RedondearControl(btnEditar, 12);
            RedondearControles.RedondearControl(btnBaja, 12);

            RedondearControles.RedondearControl(dgvListadoColaboradores, 15);
            RedondearControles.RedondearControl(pictureBox2, 15);
            RedondearControles.RedondearControl(panelBuscar, 15);
        }

        private void disenoFlowlayoutpanel4_Paint(object sender, PaintEventArgs e)
        {

        }

        private void btnAdd_Click(object sender, EventArgs e)
        {
            NavegacionHelper.AbrirFormulario(new FrmAgregarEmpresa(), ref formularioActivo, btnAdd);

        }
    }
}
